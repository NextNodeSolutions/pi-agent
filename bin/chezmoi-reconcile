#!/usr/bin/env bash
# Direction rule: only on the Mac Studio is the live config the truth, so only there does a target deleted live leave the chezmoi source.
set -euo pipefail

[[ "$(hostname -s)" == "mac-studio" ]] || exit 0
command -v chezmoi >/dev/null 2>&1 || exit 0

dest="$(chezmoi execute-template '{{ .chezmoi.destDir }}')"

deleted=()
while IFS= read -r line; do
  [[ "${line:0:1}" == "D" ]] || continue
  deleted+=("${line:3}")
done < <(chezmoi status | sort)

kept=()
for target in ${deleted[@]+"${deleted[@]}"}; do
  nested=0
  for parent in ${kept[@]+"${kept[@]}"}; do
    [[ "$target" == "$parent/"* ]] && { nested=1; break; }
  done
  (( nested )) || kept+=("$target")
done

for target in ${kept[@]+"${kept[@]}"}; do
  if chezmoi forget --force "$dest/$target" >/dev/null 2>&1; then
    echo "chezmoi-reconcile: forgot $target"
  else
    echo "chezmoi-reconcile: could not forget $target" >&2
  fi
done
