#!/usr/bin/env node
import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const PROVIDER = "openai-codex";
const AGENT_DIR = join(homedir(), ".pi", "agent");
const AUTH_FILE = join(AGENT_DIR, "auth.json");
const BINDING = JSON.parse(readFileSync(join(homedir(), ".config", "agent-secrets", "core-vault.json"), "utf8"));
const INFISICAL_API = "https://app.infisical.com/api";

const log = (message) => console.log(`${new Date().toISOString()} ${message}`);

function writePrivately(path, text) {
  const temporary = `${path}.tmp`;
  writeFileSync(temporary, text, { mode: 0o600 });
  renameSync(temporary, path);
}

const readJson = (path) => (existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : {});

async function fromVault() {
  const clientId = process.env.INFISICAL_UNIVERSAL_AUTH_CLIENT_ID;
  const clientSecret = process.env.INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET;
  if (!clientId || !clientSecret) throw new Error("INFISICAL_UNIVERSAL_AUTH_CLIENT_ID and _SECRET must be in the environment");
  const login = await fetch(`${INFISICAL_API}/v1/auth/universal-auth/login`, {
    method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ clientId, clientSecret }),
  });
  if (!login.ok) throw new Error(`Infisical login failed: HTTP ${login.status}`);
  const { accessToken } = await login.json();
  const { path, oauth } = BINDING.clients.pi;
  const query = new URLSearchParams({ workspaceId: BINDING.projectId, environment: BINDING.environment, secretPath: path });
  const response = await fetch(`${INFISICAL_API}/v3/secrets/raw/${oauth.codex}?${query}`, { headers: { authorization: `Bearer ${accessToken}` } });
  if (response.status === 404) throw new Error("no Codex token is published: run pi-token-sync --publish on the machine that signed in");
  if (!response.ok) throw new Error(`Infisical refused the Codex token: HTTP ${response.status}`);
  const entry = JSON.parse((await response.json()).secret.secretValue);
  const isValid = typeof entry.access === "string" && entry.access && Number.isFinite(entry.expires) && typeof entry.accountId === "string";
  if (!isValid) throw new Error("the published Codex token is malformed");
  return entry;
}

/** Only the machine that signed in holds a refresh token; it keeps its own session and is never overwritten. */
function apply(entry) {
  const auth = readJson(AUTH_FILE);
  const current = auth[PROVIDER];
  const hours = ((entry.expires - Date.now()) / 3.6e6).toFixed(1);
  if (current?.type === "oauth" && current.refresh) return log(`${PROVIDER}: this machine has its own sign-in, nothing changed`);
  if (current?.type === "oauth" && current.access === entry.access) return log(`${PROVIDER}: already current, valid ${hours} h`);
  auth[PROVIDER] = { type: "oauth", access: entry.access, refresh: "", expires: entry.expires, accountId: entry.accountId };
  mkdirSync(AGENT_DIR, { recursive: true, mode: 0o700 });
  writePrivately(AUTH_FILE, `${JSON.stringify(auth, null, 2)}\n`);
  log(`${PROVIDER}: updated, valid ${hours} h`);
}

try {
  apply(await fromVault());
} catch (error) {
  log(`error: ${error.message}`);
  process.exit(1);
}
